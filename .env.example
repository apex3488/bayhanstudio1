# Публичный адрес сайта (для canonical, hreflang, sitemap, Open Graph).
# На Vercel можно не задавать: используется адрес production-деплоя.
NEXT_PUBLIC_SITE_URL=

# Необязательно. Если заданы обе переменные, форма на странице контактов
# отправляет заявку напрямую в Telegram через Bot API (серверный маршрут).
# Если не заданы — форма открывает Telegram с готовым текстом заявки.
# Токен получают у @BotFather, chat id — у чата, куда бот должен писать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
